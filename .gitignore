# pixi environments
.pixi/*
!.pixi/config.toml

# rust / cargo
/target/

# coverage reports (tarpaulin writes these to the repo root)
/lcov.info

# reference repo clones (read-only, never committed)
/reference/

# macOS
.DS_Store

# claude code
.claude/*

# local planning docs (kept out of the remote), except the cookbook and its generator
/docs/*
!/docs/recipes.md
!/docs/recipes/

# inputs and outputs the cookbook generator fetches and writes
/docs/recipes/cache/

# editor settings
/.vscode/

# python bytecode
__pycache__/
*.pyc
