# pixi environments
.pixi/*
!.pixi/config.toml

# rust / cargo
/target/

# coverage reports (tarpaulin writes these to the repo root)
/lcov.info

# reference repo clones (read-only, never committed)
/reference/

# macOS
.DS_Store

# claude code
.claude/*

# local planning docs (kept out of the remote), except the cookbook and its workflow
/docs/*
!/docs/recipes.md
!/docs/recipes/

# inputs, results and records the cookbook workflow writes, and its pixi environment
/docs/recipes/cache/
/docs/recipes/results/
/docs/recipes/.snakemake/
/docs/recipes/.pixi/

# editor settings
/.vscode/

# python bytecode
__pycache__/
*.pyc
